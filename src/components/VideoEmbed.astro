---
interface Props { videoId: string; title: string; summary: string; }
const { videoId, title, summary } = Astro.props;
const youtubeUrl = `https://www.youtube.com/watch?v=${videoId}`;
---
<div class="video-card" data-video-embed data-video-id={videoId} data-video-title={title}>
  <div class="video-frame">
    <button
      class="video-poster"
      type="button"
      data-video-trigger
      aria-label={`Play ${title} in page`}
      aria-expanded="false"
    >
      <img src="/images/steam/battlefield-mechs.jpg" alt="Large-scale Pax Autocratica battle used as the video preview" loading="lazy" width="1920" height="1080" />
      <span class="play-button" aria-hidden="true">▶</span>
      <strong>PLAY IN PAGE</strong>
    </button>
    <div class="video-player" data-video-player hidden></div>
    <p class="video-status" data-video-status role="status" aria-live="polite">Select play to load the private YouTube player.</p>
  </div>
  <div class="video-copy">
    <h3>{title}</h3>
    <p>{summary}</p>
    <a class="video-fallback" href={youtubeUrl} target="_blank" rel="noopener noreferrer external">Open on YouTube ↗</a>
  </div>
</div>

<script>
  const embedBaseUrl = 'https://www.youtube-nocookie.com/embed/';

  document.querySelectorAll('[data-video-embed]').forEach((card) => {
    const videoCard = card as HTMLElement;
    if (videoCard.dataset.videoReady === 'true') return;
    videoCard.dataset.videoReady = 'true';

    const trigger = videoCard.querySelector('[data-video-trigger]');
    const player = videoCard.querySelector('[data-video-player]');
    const status = videoCard.querySelector('[data-video-status]');
    const videoId = videoCard.dataset.videoId;
    if (!(trigger instanceof HTMLButtonElement) || !(player instanceof HTMLElement) || !(status instanceof HTMLElement) || !videoId) return;

    trigger.addEventListener('click', () => {
      if (player.querySelector('iframe')) return;

      status.textContent = 'Loading the private YouTube player…';
      const iframe = document.createElement('iframe');
      iframe.src = `${embedBaseUrl}${videoId}?autoplay=1`;
      iframe.title = videoCard.dataset.videoTitle || 'Pax Autocratica video';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share; fullscreen';
      iframe.setAttribute('allowfullscreen', '');
      iframe.setAttribute('loading', 'lazy');
      iframe.setAttribute('tabindex', '0');
      player.replaceChildren(iframe);
      player.hidden = false;
      trigger.hidden = true;
      trigger.setAttribute('aria-expanded', 'true');
      status.textContent = 'Video player ready.';
      iframe.focus({ preventScroll: true });
    });
  });
</script>
